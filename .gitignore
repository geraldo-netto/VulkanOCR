# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Packaging output, and what an editable install leaves behind
build/
dist/
*.egg-info/

# Model graphs are third-party ports of PaddleOCR's weights, fetched at setup
# and pinned by their publishers. They are hundreds of megabytes and belong
# with the projects that converted them, not in this history — THIRD-PARTY.md
# says where each comes from. The patterns are scoped to those directories
# rather than global, so a `.param` this project ever adds on purpose is not
# silently invisible.
/PaddleOCR-ncnn-CPP/
/nihui-port/
/PaddleOCR-ncnn-CPP/models/
/*.tar.gz

# What the benchmarks write: a rendered corpus and one result document per
# engine. Both are regenerated by `benchmarks/make_corpus.py` and the runners,
# and the numbers that matter are quoted in docs/benchmarks.md.
/corpus/
results-*.json
